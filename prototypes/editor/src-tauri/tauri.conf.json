{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipes protótipo do editor",
  "version": "0.2.0",
  "identifier": "br.clipes.prototipo.editor",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "npm run preparar", "wait": true }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clipes · editor de Cortes (protótipo)",
        "width": 1480,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "backgroundColor": "#14161b"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
