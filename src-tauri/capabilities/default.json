{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas do shell do Clipes",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/GUSTAVOHOOO/clipes" },
        { "url": "https://github.com/GUSTAVOHOOO/clipes/issues/new*" },
        { "url": "https://github.com/GUSTAVOHOOO/clipes/blob/master/SECURITY.md" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**" }
      ],
      "deny": [
        { "path": "**/*.exe" },
        { "path": "**/*.EXE" },
        { "path": "**/*.bat" },
        { "path": "**/*.BAT" },
        { "path": "**/*.cmd" },
        { "path": "**/*.CMD" },
        { "path": "**/*.ps1" },
        { "path": "**/*.PS1" },
        { "path": "**/*.vbs" },
        { "path": "**/*.VBS" },
        { "path": "**/*.msi" },
        { "path": "**/*.MSI" },
        { "path": "**/*.scr" },
        { "path": "**/*.SCR" },
        { "path": "**/*.sh" },
        { "path": "**/*.AppImage" }
      ]
    }
  ]
}
