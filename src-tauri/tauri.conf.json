{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipes",
  "version": "2.0.0",
  "identifier": "io.github.gustavohooo.clipes",
  "build": {
    "beforeDevCommand": "bun run --cwd front-v2 dev:tauri",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "bun run --cwd front-v2 build",
    "frontendDist": "../front-v2/dist"
  },
  "app": { "windows": [{ "title": "Clipes", "width": 900, "height": 600 }] },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4MjQ2MTY1QzM4RUIxNTEKUldSUnNZN0RaV0VrdUExWkRydkZVRWorM29YZno3STBoVDN1LzJBK2M5M1JHOWVCWE5tM1J1M0EK",
      "endpoints": ["https://github.com/GUSTAVOHOOO/clipes/releases/latest/download/latest.json"]
    }
  }
}
